#!/usr/bin/env bash
set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"
set -a
source ./bosh.env
set +a

bosh create-release --force
bosh upload-release
release_manifest=$(ls -v dev_releases/juicefs/juicefs-*.yml | tail -n 1)
release_version=$(bosh interpolate "$release_manifest" --path /version)

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
bosh -d cf manifest > "$work/cf.yml"
system_domain=$(bosh interpolate "$work/cf.yml" --path /instance_groups/name=control/jobs/name=cloud_controller_ng/properties/system_domain)

bosh -n -d juicefs deploy deployment/juicefs.yml \
  -o deployment/operations/non-ha-validation.yml \
  -o deployment/operations/misc/ibosh-bosh-dns-fix.yml \
  -o deployment/operations/misc/ibosh-cf-credentials.yml \
  -v juicefs_cf_system_domain="$system_domain"

bosh update-config --type=runtime --name=juicefs -n \
  deployment/runtime-configs/juicefs-volume-driver.yml \
  -v juicefs_release_version="$release_version"

bosh -n -d cf deploy "$work/cf.yml" \
  -o deployment/operations/cf/non-ha-validation.yml \
  -o deployment/operations/cf/enable-volume-services.yml
