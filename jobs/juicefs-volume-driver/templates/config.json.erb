<%
  require 'json'
  volume = link('juicefs_volume')
  metadata = volume.p('juicefs.metadata')
  if_link('azure_postgres_proxy') do |proxy|
    raise 'Azure PostgreSQL proxy requires postgres metadata without a password' unless metadata['type'] == 'postgres' && metadata.fetch('password', '').empty?
    raise 'Azure PostgreSQL proxy must be colocated' unless proxy.instances.any? { |instance| instance.id == spec.id }
    metadata = metadata.merge('host' => '127.0.0.1', 'port' => proxy.p('azure_postgres_auth_proxy.port'), 'options' => 'sslmode=disable')
  end
  config = {
    metadata: metadata,
    storage: volume.p('juicefs.storage').merge('caFile' => '/var/vcap/jobs/juicefs-volume-driver/config/webdav-ca.crt'),
    volume: {name: volume.p('juicefs.volume.name'), mountPoint: p('juicefs.driver.mount_root'), cacheDir: p('juicefs.driver.cache_root'), subdir: ''}
  }
%><%= JSON.generate(config) %>
