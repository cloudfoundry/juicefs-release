#!/usr/bin/env bash
set -euo pipefail

RUN_DIR=/var/vcap/sys/run/juicefs-volume-driver
LOG_DIR=/var/vcap/sys/log/juicefs-volume-driver
PIDFILE=${RUN_DIR}/juicefs-volume-driver.pid

case "${1:-}" in
  start)
    install -d -m 0750 "$RUN_DIR" "$LOG_DIR"
    rm -f "$PIDFILE"
    echo $$ > "$PIDFILE"
    exec /var/vcap/packages/cf-volume-driver/bin/cf-volume-driver \
      >> "$LOG_DIR/driver.stdout.log" 2>> "$LOG_DIR/driver.stderr.log"
    ;;
  stop)
    if [ -s "$PIDFILE" ]; then
      pid=$(<"$PIDFILE")
      if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
        kill -TERM "$pid" 2>/dev/null || true
      else
        rm -f "$PIDFILE"
      fi
    fi
    ;;
  *)
    echo "Usage: ctl {start|stop}" >&2
    exit 2
    ;;
esac
