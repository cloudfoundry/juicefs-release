<%
  require 'json'
  metadata = p('juicefs.metadata')
  storage = p('juicefs.storage')
  name = p('juicefs.volume.name')
  if_link('juicefs_volume') do |volume|
    raise 'linked volume cannot override backend properties' unless metadata.empty? && storage.empty?
    metadata = volume.p('juicefs.metadata')
    storage = volume.p('juicefs.storage')
    name = volume.p('juicefs.volume.name')
  end
  raise 'JuiceFS metadata and storage settings are required' if metadata.empty? || storage.empty?
  config = {
    metadata: metadata,
    storage: storage.merge('caFile' => '/var/vcap/jobs/juicefs-volume/config/webdav-ca.crt'),
    volume: {name: name, mountPoint: p('juicefs.volume.mount_point'), cacheDir: '/var/vcap/data/juicefs-volume/cache', subdir: ''}
  }
%><%= JSON.generate(config) %>
