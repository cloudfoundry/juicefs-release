---
name: juicefs-volume
description: Mounts the full JuiceFS root via FUSE on the broker VM.
templates:
  config.json.erb: config/config.json
  pre-start.erb: bin/pre-start
  ctl.erb: bin/ctl
  mount: bin/mount
  webdav-ca.crt.erb: config/webdav-ca.crt
packages:
- juicefs
provides:
- name: juicefs_mount
  type: juicefs_mount
  properties:
  - juicefs.volume.name
  - juicefs.volume.mount_point
  - juicefs.metadata
  - juicefs.storage
consumes:
- name: juicefs_volume
  type: juicefs_mount
  optional: true
properties:
  juicefs.metadata:
    description: Metadata backend with type (postgres or mysql), host, port, database, user, password and optional connection options. Set only on the provider mounter; consumers use juicefs_volume.
    default: {}
  juicefs.storage:
    description: Object backend with type (webdav, s3 or wasb for Azure Blob), bucket URL, access_key, secret_key, optional session_token and ca_cert. Set only on the provider mounter.
    default: {}
  juicefs.volume.name:
    description: Name of the shared volume.
    default: juicefs-poc
  juicefs.volume.initialize:
    description: Initialize an unformatted filesystem in pre-start on the bootstrap instance. Backends must run on a separate instance; existing filesystems are never updated.
    default: false
  juicefs.volume.mount_point:
    description: FUSE mountpoint on the VM.
    default: /var/vcap/data/juicefs-volume/mount
