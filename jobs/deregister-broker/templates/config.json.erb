<%
  require 'json'
  config = {
    apiURL: "https://api.#{p('juicefs.cf.system_domain')}",
    caCert: p('juicefs.cf.additional_ca_certificates').join("\n"),
    brokerName: p('juicefs.broker.name'),
    brokerURL: "http://#{link('juicefs_broker').instances.first.address}:#{link('juicefs_broker').p('juicefs.broker.port')}",
    brokerPort: link('juicefs_broker').p('juicefs.broker.port'),
    brokerUsername: link('juicefs_broker').p('juicefs.broker.username'),
    brokerPassword: link('juicefs_broker').p('juicefs.broker.password'),
    cfUsername: p('juicefs.cf.username'),
    cfPassword: p('juicefs.cf.password'),
    skipSSLValidation: p('juicefs.cf.skip_ssl_validation'),
    skipBrokerSSLValidation: p('juicefs.broker.skip_ssl_validation')
  }
%><%= JSON.generate(config) %>
