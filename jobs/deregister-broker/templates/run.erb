#!/usr/bin/env bash
set -euo pipefail
export SSL_CERT_FILE=/var/vcap/packages/ca-certificates/certs/ca-certificates.crt
export SSL_CERT_DIR=/var/vcap/packages/ca-certificates/no-system-certs
export BROKER_REGISTRATION_CONFIG=/var/vcap/jobs/deregister-broker/config/config.json
exec /var/vcap/packages/broker-registration/bin/broker-registration deregister
