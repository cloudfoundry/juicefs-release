---
name: format-volume
description: Initializes the JuiceFS metadata and WebDAV objects once; subsequent runs do not update an existing volume.
templates:
  run.erb: bin/run
  config.json.erb: config/config.json
  webdav-ca.crt.erb: config/webdav-ca.crt
packages:
- juicefs
- juicefs-launcher
- ca-certificates
consumes:
- name: postgres
  type: database
- name: blobstore
  type: webdav
properties:
  juicefs.volume.name:
    description: Name of the volume to initialize.
    default: juicefs-poc
