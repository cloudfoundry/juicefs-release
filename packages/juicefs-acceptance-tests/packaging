#!/usr/bin/env bash
set -e -x
source /var/vcap/packages/golang-1.25-linux/bosh/compile.env
export GOPROXY=off GOSUMDB=off GOTOOLCHAIN=local CGO_ENABLED=0
cd "${BOSH_COMPILE_TARGET}/juicefs-acceptance-tests"
mkdir -p "${BOSH_INSTALL_TARGET}/bin"
go build -mod=vendor -trimpath -ldflags='-s -w' -o "${BOSH_INSTALL_TARGET}/bin/test-app" ./cmd/test-app
go test -mod=vendor -c -trimpath -ldflags='-s -w' -o "${BOSH_INSTALL_TARGET}/bin/acceptance.test" ./acceptance
