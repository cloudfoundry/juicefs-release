#!/usr/bin/env bash
set -e -x

source /var/vcap/packages/golang-1.25-linux/bosh/compile.env
export GOPROXY=off
export GOSUMDB=off
export GOTOOLCHAIN=local
export GOFLAGS=-mod=vendor

cd "${BOSH_COMPILE_TARGET}/juicefs"
mkdir -p "${BOSH_INSTALL_TARGET}/bin"
CGO_ENABLED=1 go build -trimpath -ldflags='-s -w' -o "${BOSH_INSTALL_TARGET}/bin/juicefs" .
